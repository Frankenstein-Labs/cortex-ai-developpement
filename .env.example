# Public browser configuration for the Vite CORTEX Web deployment.
# Use the public HTTPS Cloud Control origin; never place database or provider secrets here.
VITE_CLOUD_CONTROL_URL=https://api.example.com

# Public marketing-to-app destination. This is consumed by apps/marketing.
NEXT_PUBLIC_CORTEX_APP_URL=https://app.example.com

# Cloud Control only (apps/cloud-control). Use an application-role PostgreSQL URL,
# not an owner/migration connection string. Do not commit real values.
CORTEX_DATABASE_URL=postgresql://app:password@db.example.com:5432/cortex
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
CORTEX_ENVIRONMENT=development
CORTEX_COOKIE_SECURE=false
CORTEX_ALLOWED_ORIGINS=http://localhost:5173
# Optional: CORTEX_SESSION_COOKIE=cortex_cloud_session
# Optional: CORTEX_SESSION_TTL_SECONDS=604800
# Optional: CORTEX_COOKIE_SAMESITE=lax
